diff --git a/test/settings-locale-without-region.test.js b/test/settings-locale-without-region.test.js
new file mode 100644
index 0000000..d3ac8d2
--- /dev/null
+++ b/test/settings-locale-without-region.test.js
@@ -0,0 +1,35 @@
+'use strict';
+// Регрессия крашей #48213 (de), #48377 (pt), #48530 (fil), Android 11/12:
+// Settings падал в regionOf (src/lib/locale.js:10) с TypeError (reading 'toUpperCase'),
+// когда в locale нет второго подтега.
+//
+// Профили здесь СИНТЕТИЧЕСКИЕ, это не зеркала реальной оболочки: копия
+// devices/galaxy-s21-de-de.json, в которой заменён только locale.
+const test = require('node:test');
+const assert = require('node:assert');
+const { openScreen } = require('../src/app');
+
+const galaxy = require('../devices/galaxy-s21-de-de.json');
+
+const CASES = [
+  { locale: 'de', report: '48213' },
+  { locale: 'pt', report: '48377' },
+  { locale: 'fil', report: '48530' },
+];
+
+for (const { locale, report } of CASES) {
+  test(`settings opens for locale without region "${locale}" (crash #${report})`, () => {
+    const profile = { ...galaxy, locale };
+    const screen = openScreen('settings', profile);
+
+    assert.deepStrictEqual(screen.sections.map((s) => s.id), ['account', 'region', 'storage', 'display']);
+
+    // Без региона обе строки показывают «—»; неявный USD недопустим.
+    const region = screen.sections.find((s) => s.id === 'region');
+    assert.deepStrictEqual(region.rows, [
+      { label: 'Language', value: locale },
+      { label: 'Region', value: '—' },
+      { label: 'Currency', value: '—' },
+    ]);
+  });
+}
